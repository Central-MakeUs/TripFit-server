# 로컬 검증은 scripts/single-local.sh up이 임시 값을 자동 생성한다.
# 수동 검증 때만 이 파일을 복사하고 채운다. 운영용 Secrets를 복사하지 않는다.
GHCR_IMAGE=tripfit-single-local:verify
MYSQL_DATABASE=tripfit
MYSQL_ROOT_PASSWORD=
SPRING_DATASOURCE_USERNAME=tripfit_app
SPRING_DATASOURCE_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# 로컬 readiness 검증은 외부 공급자 키 없이 실행한다.
SOCIAL_TOKEN_AES_KEY=
APP_PORT=18081
NGINX_HTTP_PORT=18080
COOKIE_DOMAIN=localhost
COOKIE_SECURE=true
