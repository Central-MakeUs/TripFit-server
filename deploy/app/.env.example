# ============================================================
# EC2 A — Spring Boot API 설정 (GHCR pull, 원격 MySQL)
# ============================================================

# EC2 B private IP (같은 VPC). public IP는 dev 임시 점검용만.
MYSQL_HOST=<EC2 B private IP>
MYSQL_PORT=3306
MYSQL_DATABASE=tripfit
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

APP_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SPRING_PROFILES_ACTIVE=dev

# EC2 C(모니터링) private IP — docs/decisions/009-observability-logging.md. CI/CD는 LOKI_HOST GitHub Secret으로 덮어씀
LOKI_HOST=<EC2 C private IP>

# EC2 D(Redis) private IP — docs/decisions/010-redis-infra.md. access token 블랙리스트(RTR, #4)
REDIS_HOST=<EC2 D private IP>
REDIS_PORT=6379
REDIS_PASSWORD=

# TLS (scripts/init-letsencrypt.sh)
CERTBOT_DOMAIN=api.tripfit.online
CERTBOT_EMAIL=codus5068@naver.com

# GHCR (private 패키지)
GHCR_IMAGE=ghcr.io/central-makeus/tripfit-server:latest

# JWT (docs/decisions/004-auth-token-rotation.md: access 15분 · refresh 30일)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION_DAYS=30

# refreshToken 쿠키 속성 (docs/specs/auth/auth-refresh-redis-cookie.md).
# prod는 api.tripfit.online·tripfit.online(Vercel) 서브도메인 간 쿠키 공유를 위해 상위 도메인으로 지정.
COOKIE_DOMAIN=.tripfit.online
COOKIE_SECURE=true

# OAuth provider client IDs (token aud 검증) · authorization code 교환
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Google Calendar 연동 전용 (로그인과 분리된 별도 Client ID — #78)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# Apple client_secret JWT (로그인 시 authorizationCode 교환 · 탈퇴 시 revoke 호출)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Kakao Admin Key — 탈퇴 시 unlink(POST /v1/user/unlink) 호출용
KAKAO_ADMIN_KEY=

# 소셜 refresh token(Apple 로그인·Google 로그인·Google Calendar) 암호화 공용 AES-256-GCM 키
SOCIAL_TOKEN_AES_KEY=

# FCM (docs/specs/notification.md — D4 FCM 단일 채널). 서비스 계정 JSON을 base64 인코딩해 통째로 넣는다.
FIREBASE_CREDENTIALS_BASE64=

# 공공데이터포털 특일 정보 API (공휴일·대체공휴일 — 발급 절차: deploy/holiday-api-setup.md).
# 포털이 Encoding/Decoding 두 형태를 발급하는데 반드시 **Decoding** 키를 넣는다(Encoding 키는 이중 인코딩돼 인증 실패).
# 비워 두면 동기화를 건너뛰고 공휴일 없음으로 동작한다.
HOLIDAY_API_SERVICE_KEY=
