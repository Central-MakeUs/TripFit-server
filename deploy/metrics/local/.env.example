# 배포 전 로컬 점검 (deploy/metrics/docker-compose.local.yml). cp .env.example .env 후 값 채우기 — 커밋 금지.

# 로컬 Grafana → 리포터 공유 토큰(아무 값)
REPORTER_TOKEN=local-smoke-token

# Gemini 무료 등급 API 키와 모델 이름(AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# 점검 메시지를 보낼 Discord 웹훅 — 기존 알림 채널(제목에 [local]이 붙는다)
DISCORD_WEBHOOK_URL=
