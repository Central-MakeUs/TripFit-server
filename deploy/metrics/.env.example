# EC2 E — Prometheus + AI 원인 리포터 (deploy/metrics/docker-compose.yml)
# 문서용 목록이다. 운영 값은 GitHub Secrets에만 두고 CI(deploy-metrics)가 환경 변수로 넣는다 — 서버 .env 직접 수정 금지.
# 괄호는 대응하는 GitHub Secret 이름이다(docs/specs/cross-cutting/add-prometheus.md "GitHub Secrets").

# CI가 GHCR에 올린 리포터 이미지 — CI가 채운다
REPORTER_IMAGE=

# 수집 대상 private IP — EC2 A(앱+nginx), EC2 B(MySQL)
APP_HOST=        # (APP_PRIVATE_HOST)
DB_HOST=         # (MYSQL_HOST)
# EC2 C(Loki) private IP. 비우면 compose의 기본값을 쓴다
LOKI_HOST=

# Grafana(EC2 C) 감시 규칙이 리포터를 부를 때 쓰는 공유 토큰. C의 REPORTER_TOKEN과 같은 값
REPORTER_TOKEN=

# Gemini 무료 등급 API 키(AI Studio 발급)와 모델 이름
GEMINI_API_KEY=
GEMINI_MODEL=

# 리포트를 보낼 Discord 웹훅 — 기존 알림 채널
DISCORD_WEBHOOK_URL=
