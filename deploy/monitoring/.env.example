# EC2 C — Loki + Grafana
# 문서용 목록이다. 운영 값은 GitHub Secrets에만 두고 CI(deploy-monitoring)가 환경 변수로 넣는다 — 서버 .env 직접 수정 금지.
GRAFANA_ADMIN_PASSWORD=

# EC2 E(Prometheus + AI 원인 리포터) private IP — #126 임계점 감시
PROMETHEUS_HOST=
# Grafana 감시 규칙이 리포터(/alerts)를 부를 때 쓰는 공유 토큰. EC2 E의 REPORTER_TOKEN과 같은 값
REPORTER_TOKEN=
